RewriteEngine On
Options -indexes

# API aplikasi absensi mobile -> SATU front controller (app/api/index.php).
# Semua URL /api/... ditangani di sana (lihat docs/INTEGRASI-ABSEN-MOBILE.md).
RewriteRule ^api(/.*)?$ app/api/index.php [L,QSA]

# File upload API disimpan di app/uploads/, tetapi path publik tetap
# menggunakan uploads/... agar kompatibel dengan aplikasi mobile.
RewriteRule ^uploads/(.*)$ app/uploads/$1 [L]

RewriteRule ^data-saya cetak.php

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php

RewriteRule ^([a-zA-Z0-9_-]+)$ index.php?page=$1
RewriteRule ^([a-zA-Z0-9_-]+)/$ index.php?page=$1

# KONFIRGURASI PEMANGGILAN ID
RewriteCond $1 !^(index\.php)

# PEMAGIILAN BERDASARKAN ID USER
RewriteRule ^karier/([^/\.]+)/?$ index.php?page=karier&id=$1 [L]

# DELETE 
RewriteRule ^delete-konselor/([^/\.]+)/?$ index.php?page=delete-konselor&id=$1 [L]
RewriteRule ^delete-peserta/([^/\.]+)/?$ index.php?page=delete-peserta&id=$1 [L]
