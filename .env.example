APP_ENV=development
APP_URL=http://localhost:8000/

# --- Development (APP_ENV=development): DB_* opsional. ---
# Default lokal: HOST=127.0.0.1 PORT=3306 USER=root PASS=(kosong) DB=ipm_hris.
# Database otomatis dibuat bila belum ada saat aplikasi/phinx dijalankan.
# Jika MySQL lokal pakai password, cukup isi DB_PASSWORD (dan DB_USERNAME bila beda).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ipm_hris
DB_USERNAME=root
DB_PASSWORD=

# --- Production (APP_ENV=production): WAJIB isi semua DB_* eksplisit. ---
# APP_ENV=production
# APP_URL=https://example.com/
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_database_name
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_database_password
